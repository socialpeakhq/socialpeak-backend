generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int              @id @default(autoincrement())
  email                   String           @unique
  password                String
  createdAt               DateTime         @default(now())
  full_name               String
  has_connected_workspace Boolean?         @default(false)
  phone_number            String
  token                   String?
  workspaces              Workspace[]
  meta_connections_linked MetaConnection[]
}

model Workspace {
  workspace_id       Int             @id @default(autoincrement())
  owner_id           Int
  workspace_name     String
  created_at         DateTime        @default(now())
  connected_accounts String[]        @default([])
  workspace_owner    User            @relation(fields: [owner_id], references: [id])
  meta_connection    MetaConnection?
  facebook_pages     FacebookPage[]
  posts              Post[]
}

model MetaConnection {
  id                           Int       @id @default(autoincrement())
  workspace_id                 Int       @unique
  workspace                    Workspace @relation(fields: [workspace_id], references: [workspace_id])
  linked_by_id                 Int
  linked_by                    User      @relation(fields: [linked_by_id], references: [id])
  user_access_token            String
  user_access_token_expires_at DateTime?
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt
}

model FacebookPage {
  id                            Int                 @id @default(autoincrement())
  workspace_id                  Int
  workspace                     Workspace           @relation(fields: [workspace_id], references: [workspace_id])
  page_id                       String              @unique
  page_name                     String
  page_access_token             String
  instagram_account_id          String?             @unique
  instagram_username            String?
  instagram_name                String?
  instagram_profile_picture_url String?
  created_at                    DateTime            @default(now())
  updated_at                    DateTime            @updatedAt
  insightsSnapshots             InsightsSnapshots[]
  posts                         Post[]

  @@index([workspace_id])
}

model InsightsSnapshots {
  id               Int          @id @default(autoincrement())
  facebook_page_id Int
  facebook_page    FacebookPage @relation(fields: [facebook_page_id], references: [id])
  platform         String
  metric           String
  value            Int
  captured_at      DateTime
  created_at       DateTime

  @@unique([facebook_page_id, platform, metric, captured_at])
  @@index([facebook_page_id, captured_at])
}

model Post {
  id               Int          @id @default(autoincrement())
  workspace_id     Int
  workspace        Workspace    @relation(fields: [workspace_id], references: [workspace_id])
  facebook_page_id Int
  facebook_page    FacebookPage @relation(fields: [facebook_page_id], references: [id])
  type             String
  caption          String
  media_urls       String[]     @default([])
  created_at       DateTime     @default(now())
  targets          PostTarget[]
  scheduled_at     DateTime?
  platforms        String[]     @default([])
  status           String       @default("fired")
  metadata         Json?
}

model PostTarget {
  id                   Int       @id @default(autoincrement())
  post_id              Int
  post                 Post      @relation(fields: [post_id], references: [id])
  platform             String // 'facebook' | 'instagram'
  status               String // 'pending' | 'processing' | 'published' | 'failed'
  external_post_id     String?
  error_message        String?
  published_at         DateTime?
  container_id         String?
  container_created_at DateTime?
  child_container_ids  String[]  @default([])

  @@unique([post_id, platform])
}
